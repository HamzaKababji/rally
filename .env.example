# Copy to .env.local (gitignored) and fill in from Supabase → Project Settings → API Keys.
# Use the PUBLISHABLE key (sb_publishable_…). Never put the secret/service_role key here:
# every VITE_ variable is bundled into the client and visible to anyone with the link.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
